{
  "name": "dsh-plugin-pomodoro",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Pomodoro timer and Trello-style task board for DeepSeek Harness: floating timer, SQLite-backed board with lists, labels, priorities, due dates, subtasks, smart sections and per-task focus time.",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "lib/db.js",
    "lib/api.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.js",
    "verify:static": "./scripts/verify-plugin.sh --static-only",
    "verify": "./scripts/verify-plugin.sh",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:board": "node scripts/verify-board.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atzx/dsh-plugin-pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/atzx/dsh-plugin-pomodoro/issues"
  },
  "homepage": "https://github.com/atzx/dsh-plugin-pomodoro#readme",
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
